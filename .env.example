# All values may be left empty: ingestion + retrieval still work (local models);
# LLM endpoints return 503 with a clear message.

# --- Groq (primary LLM provider) ---
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GROQ_VISION_MODEL=
GROQ_STT_MODEL=

# --- Optional fallback provider (OpenRouter, OpenAI-compatible) ---
FALLBACK_PROVIDER_KEY=
# Optional overrides (defaults in app/config.py)
# FALLBACK_CHAT_MODEL=
# FALLBACK_VISION_MODEL=

# --- Langfuse tracing (off when empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Hugging Face (push router adapter, deploy Space) ---
HF_TOKEN=

# --- Behaviour switches ---
# Prompt file version used by /ask: v1 | v2
PROMPT_VERSION=
# Router: prompt | finetuned
ROUTER_MODE=

# --- Optional infra overrides (defaults work for local runs) ---
# REDIS_URL=redis://localhost:6379/0     # fakeredis:// = in-process, no Docker needed
# QUEUE_MODE=rq                          # inline = run ingestion jobs in-process (Windows without Docker)
# CHROMA_URL=                            # http://chroma:8000 in docker compose
# ROUTER_ADAPTER=                        # HF Hub id of the Phase 7 LoRA adapter (ROUTER_MODE=finetuned)
